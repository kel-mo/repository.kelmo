<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.kelmo" name="kel-mo Add-on Repository" version="1.0.0" provider-name="kel-mo">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository">
    <dir minversion="19.0.0">
      <info>https://kel-mo.github.io/repository.kelmo/addons.xml</info>
      <checksum>https://kel-mo.github.io/repository.kelmo/addons.xml.md5</checksum>
      <datadir>https://kel-mo.github.io/repository.kelmo/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install add-ons by kel-mo</summary>
    <description lang="en_GB">Add-on repository for kel-mo's Kodi add-ons, such as RomM. Installing it lets Kodi find and update these add-ons automatically.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/kel-mo/repository.kelmo</source>
  </extension>
</addon>
